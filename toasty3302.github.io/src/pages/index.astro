---
import Highlights from "@/components/Highlights.astro";
import MetaPage from "@/components/MetaPage.astro";
import Status from "@/components/Status.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
    <MetaPage slot="head" />
    <dictionary-entry>
        <h1>toasty</h1>
        <Status />
        <etymology-span>
            <p>
                Schizo junior ChemE + CS minor from Cornell University.
                Interested in security research and redteaming. Also like doing
                ML/AI stuff.
            </p>
            <p>
                CTF captain for{" "}
                <a
                    href="https://ctftime.org/team/406840"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Cybears ʕ •ᴥ•ʔ
                </a>{" "}
                and slave for{" "}
                <a
                    href="https://spl.team/"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    SPL
                </a>
            </p>
            <p>Notice how there's no ChemE stuff? yea that's sad :(</p>
        </etymology-span>
    </dictionary-entry>
    <Highlights />
</Layout>

<style>
    dictionary-entry {
        display: block;
        font-size: var(--step-0);
        color: var(--muted-foreground);

        @media (width >= 64rem) {
            margin-block-start: -0.2em;
        }

        ipa-span {
            opacity: 0.6;
        }

        a {
            --underline: var(--muted-foreground);
            color: var(--foreground);
        }

        p + p {
            margin-block-start: var(--space-s);
        }

        h1 {
            font-size: var(--step-2);
            line-height: calc(var(--leading-offset) + 1em);
            font-weight: var(--font-weight-medium);
            color: var(--foreground);
            margin-block-end: var(--space-2xs);
        }

        ol {
            margin-block-start: var(--space-xs);
            list-style: none;

            li {
                padding-inline-start: 1em;
                text-indent: -1em;

                &::before {
                    content: counter(list-item);
                    display: inline-block;
                    inline-size: 1em;
                    text-indent: 0;
                    font-weight: var(--font-weight-medium);
                }

                + li {
                    margin-block-start: var(--space-3xs);
                }
            }
        }

        hr {
            margin-block: var(--space-m);
            border-block-start: 2px solid var(--border);
        }

        prose-content {
            margin-block-start: var(--space-xs);
        }
    }
</style>
